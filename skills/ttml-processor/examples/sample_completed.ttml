  <body dur="03:15.000">
    <div itunes:songPart="Verse" begin="0:10.200" end="0:13.400">
      <p begin="0:10.200" end="0:13.400" itunes:key="L1" ttm:agent="v1"><span begin="0:10.200" end="0:11.100">꽃을 </span><span begin="0:11.100" end="0:12.000">피워 </span><span begin="0:12.000" end="0:13.400">catwalking</span><span ttm:role="x-translation" xml:lang="zh-Hans">繁花盛放 步步傲然穿行</span><span ttm:role="x-roman" xml:lang="ko-Latn">kkocheul piwo</span></p>
